// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(uuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          String    @default("USER") // USER, ADMIN
  bio           String?   @db.Text
  location      String?
  latitude      Float?
  longitude     Float?
  
  // Shanti Mode / Live Status
  liveStatus          String?
  isShantiModeActive  Boolean   @default(false)

  // Seller Reputation
  sellerRating        Float     @default(5.0)
  booksSold           Int       @default(0)
  successfulExchanges Int       @default(0)
  responseTime        String    @default("Fast") // Fast, Average, Slow
  conditionAccuracy   Boolean   @default(true) // Accurate
  meetupReliability   Boolean   @default(true) // Reliable

  // Relations
  books         Book[]    @relation("OwnerToBook")
  requests      BookRequest[] @relation("RequesterToRequest")
  orders        Order[]   @relation("BuyerToOrder")
  sentMessages  Message[] @relation("SenderToMessage")
  receivedMessages Message[] @relation("ReceiverToMessage")
  accounts      Account[]
  sessions      Session[]
  badges        UserBadge[]
  libraryBooks  LibraryBook[]
  readingSessions ReadingSession[]

  wishlists     Wishlist[]
  notifications Notification[]
  donations     Donation[] @relation("DonorToDonation")
  communityRequests CommunityRequest[] @relation("CommunityRequestToUser")

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Book {
  id            String    @id @default(uuid())
  title         String
  author        String
  isbn          String?
  description   String?
  condition     String    // NEW, LIKE_NEW, GOOD, FAIR, POOR
  category      String
  status        String    @default("AVAILABLE") // AVAILABLE, RESERVED, DONATED, SOLD
  price         Float     @default(0) // 0 if donation
  
  images        String[]  // Array of image URLs
  weight        Float?    // Weight in kg (for shipping)
  dimensions    String?   // L x W x H in cm
  
  // Delivery Options
  deliveryType  String    @default("SHIPPING") // SHIPPING, MEETUP, BOTH

  // Academic Tags
  university    String?
  course        String?
  semester      Int?
  subject       String?

  // Exchange
  acceptsExchange     Boolean   @default(false)
  exchangePreferences String?

  // Bundles
  isBundle            Boolean   @default(false)
  booksInBundle       Int?      @default(1)
  bundleDescription   String?   @db.Text

  // Structured Condition (1-5 scale)
  condCover           Int?      @default(5)
  condPages           Int?      @default(5)
  condHighlighting    Int?      @default(5)
  condNotes           Int?      @default(5)
  condBinding         Int?      @default(5)

  // Relations
  ownerId       String
  owner         User      @relation("OwnerToBook", fields: [ownerId], references: [id])
  requests      BookRequest[]
  orders        Order[]
  donation      Donation?

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model BookRequest {
  id            String    @id @default(uuid())
  status        String    @default("PENDING") // PENDING, APPROVED, REJECTED, COMPLETED
  message       String?

  // Relations
  bookId        String
  book          Book      @relation(fields: [bookId], references: [id])
  
  requesterId   String
  requester     User      @relation("RequesterToRequest", fields: [requesterId], references: [id])

  messages      Message[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Account {
  id                 String  @id @default(uuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Order {
  id            String    @id @default(uuid())
  amount        Float
  status        String    @default("PENDING") // PENDING, PAID, FAILED
  paymentId     String?

  // Relations
  bookId        String
  book          Book      @relation(fields: [bookId], references: [id])
  
  buyerId       String
  buyer         User      @relation("BuyerToOrder", fields: [buyerId], references: [id])

  messages      Message[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  shipment      Shipment?
}

model Shipment {
  id            String    @id @default(uuid())
  orderId       String    @unique
  order         Order     @relation(fields: [orderId], references: [id])
  
  awbCode       String?   // Airway Bill code from Shiprocket
  courierName   String?
  trackingUrl   String?
  status        String    @default("PENDING") // PENDING, READY_TO_SHIP, SHIPPED, DELIVERED, CANCELLED
  shiprocketOrderId String? // ID returned from Shiprocket API
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Message {
  id          String   @id @default(uuid())
  content     String   @db.Text
  
  // Relations
  senderId    String
  sender      User     @relation("SenderToMessage", fields: [senderId], references: [id])
  
  receiverId  String
  receiver    User     @relation("ReceiverToMessage", fields: [receiverId], references: [id])
  
  requestId   String?
  request     BookRequest? @relation(fields: [requestId], references: [id])
  
  orderId     String?
  order       Order?   @relation(fields: [orderId], references: [id])

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Badge {
  id                    String      @id @default(uuid())
  name                  String
  description           String
  category              String      // DONATION, TRUST, COMMUNITY
  iconUrl               String
  requirementThreshold  Int

  users                 UserBadge[]

  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
}

model UserBadge {
  id          String   @id @default(uuid())
  earnedAt    DateTime @default(now())
  isPinned    Boolean  @default(false)
  
  // Relations
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  
  badgeId     String
  badge       Badge    @relation(fields: [badgeId], references: [id])

  @@unique([userId, badgeId])
}

model LibraryBook {
  id          String   @id @default(uuid())
  title       String
  author      String
  coverImage  String?
  platformBookId String? // If linked to an existing book on AksharSetu

  // Relations
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions    ReadingSession[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ReadingSession {
  id              String   @id @default(uuid())
  durationMinutes Int
  
  // Relations
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  libraryBookId   String
  libraryBook     LibraryBook @relation(fields: [libraryBookId], references: [id], onDelete: Cascade)

  createdAt       DateTime @default(now())
}

model Wishlist {
  id        String   @id @default(uuid())
  title     String?  
  isbn      String?  
  
  // Relations
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt DateTime @default(now())
}

model Notification {
  id        String   @id @default(uuid())
  type      String   // e.g., "WISHLIST_ALERT"
  message   String
  read      Boolean  @default(false)
  link      String?  
  
  // Relations
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt DateTime @default(now())
}

model Campaign {
  id            String     @id @default(uuid())
  title         String
  description   String     @db.Text
  ngoName       String
  targetBooks   Int
  currentBooks  Int        @default(0)
  startDate     DateTime   @default(now())
  endDate       DateTime?
  status        String     @default("ACTIVE") // ACTIVE, COMPLETED, CANCELLED
  imageUrl      String?

  donations     Donation[]

  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

model Donation {
  id            String    @id @default(uuid())
  trackingId    String    @unique @default(cuid()) // For public tracking
  status        String    @default("DONATED") // DONATED, COLLECTED, VERIFIED, SENT_TO_NGO, RECEIVED, DISTRIBUTED
  
  // Relations
  donorId       String
  donor         User      @relation("DonorToDonation", fields: [donorId], references: [id])
  
  bookId        String?   @unique
  book          Book?     @relation(fields: [bookId], references: [id])
  
  campaignId    String?
  campaign      Campaign? @relation(fields: [campaignId], references: [id])

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model CommunityRequest {
  id          String   @id @default(uuid())
  title       String
  author      String?
  description String?  @db.Text
  status      String   @default("OPEN") // OPEN, FULFILLED

  requesterId String
  requester   User     @relation("CommunityRequestToUser", fields: [requesterId], references: [id])

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(uuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          String    @default("USER") // USER, ADMIN
  bio           String?   @db.Text
  favoriteQuote String?   @db.Text
  quoteAuthor   String?
  location      String?
  latitude      Float?
  longitude     Float?
  
  // Shanti Mode / Live Status
  liveStatus          String?
  isShantiModeActive  Boolean   @default(false)

  // Seller Reputation
  sellerRating        Float     @default(5.0)
  booksSold           Int       @default(0)
  successfulExchanges Int       @default(0)
  responseTime        String    @default("Fast") // Fast, Average, Slow
  conditionAccuracy   Boolean   @default(true) // Accurate
  meetupReliability   Boolean   @default(true) // Reliable

  // Relations
  books             Book[]             @relation("OwnerToBook")
  requests          BookRequest[]      @relation("RequesterToRequest")
  orders            Order[]            @relation("BuyerToOrder")
  sentMessages      Message[]          @relation("SenderToMessage")
  receivedMessages  Message[]          @relation("ReceiverToMessage")
  accounts          Account[]
  sessions          Session[]
  badges            UserBadge[]
  libraryBooks      LibraryBook[]
  readingSessions   ReadingSession[]
  bookNotes         BookNote[]
  reviewsGiven      SellerReview[]     @relation("ReviewerToReview")
  reviewsReceived   SellerReview[]     @relation("SellerToReview")

  wishlists         Wishlist[]
  notifications     Notification[]
  donations         Donation[]         @relation("DonorToDonation")
  communityRequests CommunityRequest[] @relation("CommunityRequestToUser")
  clubsCreated      BookClub[]         @relation("ClubCreator")
  clubMemberships   BookClubMember[]
  clubPosts         BookClubPost[]

  // Messaging
  lastSeenAt               DateTime?
  notifyMessages           Boolean                   @default(true)
  notifyOffers             Boolean                   @default(true)
  conversationParticipants ConversationParticipant[]
  messageReactions         MessageReaction[]
  offersMade               BookOffer[]               @relation("OfferBuyer")
  offersReceived           BookOffer[]               @relation("OfferSeller")
  blocksMade               UserBlock[]               @relation("Blocker")
  blocksReceived           UserBlock[]               @relation("Blocked")
  reportsMade              UserReport[]              @relation("Reporter")
  reportsReceived          UserReport[]              @relation("Reported")

  // Identity, Progression, Streaks, Privacy & Cosmetics
  username                 String?                   @unique
  coverImage               String?
  profileFrame             String                    @default("classic") // classic, cobalt, saffron, emerald, gold, mythic
  profileTheme             String                    @default("obsidian") // obsidian, paper, midnight, forest
  selectedTitle            String?
  totalXP                  Int                       @default(0)
  aksharPoints             Int                       @default(50)
  currentStreak            Int                       @default(0)
  longestStreak            Int                       @default(0)
  lastStreakDate           String?
  lastDailyClaimDate       String?
  dailyClaimStreak         Int                       @default(0)
  readingGoalBooks         Int                       @default(12)
  unlockedCosmetics        String[]                  @default(["frame:classic", "banner:obsidian", "theme:obsidian"])
  isPublicProfile          Boolean                   @default(true)
  showOnlineStatus         Boolean                   @default(true)
  showReadingActivity      Boolean                   @default(true)
  showContributionGraph    Boolean                   @default(true)
  leaderboardOptOut        Boolean                   @default(false)

  xpTransactions           XpTransaction[]
  activities               UserActivity[]
  questClaims              UserQuestClaim[]
  followers                UserFollow[]              @relation("UserFollowers")
  following                UserFollow[]              @relation("UserFollowing")
  supportTickets           SupportTicket[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Book {
  id            String    @id @default(uuid())
  title         String
  author        String
  isbn          String?
  description   String?
  condition     String    // NEW, LIKE_NEW, GOOD, FAIR, POOR
  category      String
  status        String    @default("AVAILABLE") // AVAILABLE, RESERVED, DONATED, SOLD
  price         Float     @default(0) // 0 if donation
  
  images        String[]  // Array of image URLs
  weight        Float?    // Weight in kg (for shipping)
  dimensions    String?   // L x W x H in cm
  
  // Delivery Options
  deliveryType  String    @default("SHIPPING") // SHIPPING, MEETUP, BOTH

  // Academic Tags
  university    String?
  course        String?
  semester      Int?
  subject       String?

  // Exchange
  acceptsExchange     Boolean   @default(false)
  exchangePreferences String?

  // Bundles
  isBundle            Boolean   @default(false)
  booksInBundle       Int?      @default(1)
  bundleDescription   String?   @db.Text

  // Structured Condition (1-5 scale)
  condCover           Int?      @default(5)
  condPages           Int?      @default(5)
  condHighlighting    Int?      @default(5)
  condNotes           Int?      @default(5)
  condBinding         Int?      @default(5)

  // Relations
  ownerId       String
  owner         User      @relation("OwnerToBook", fields: [ownerId], references: [id])
  requests      BookRequest[]
  orders        Order[]
  donation      Donation?
  conversations Conversation[]
  offers        BookOffer[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model BookRequest {
  id            String    @id @default(uuid())
  status        String    @default("PENDING") // PENDING, APPROVED, REJECTED, COMPLETED
  message       String?
  offeredBookId String?   // Optional 1-for-1 swap offered book ID

  // Relations
  bookId        String
  book          Book      @relation(fields: [bookId], references: [id])
  
  requesterId   String
  requester     User      @relation("RequesterToRequest", fields: [requesterId], references: [id])

  messages      Message[]
  review        SellerReview?

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Account {
  id                 String  @id @default(uuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Order {
  id            String    @id @default(uuid())
  amount        Float
  status        String    @default("PENDING") // PENDING, PAID, FAILED
  paymentId     String?

  // Relations
  bookId        String
  book          Book      @relation(fields: [bookId], references: [id])
  
  buyerId       String
  buyer         User      @relation("BuyerToOrder", fields: [buyerId], references: [id])

  messages      Message[]
  shipment      Shipment?
  review        SellerReview?

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Shipment {
  id            String    @id @default(uuid())
  orderId       String    @unique
  order         Order     @relation(fields: [orderId], references: [id])
  
  awbCode       String?   // Airway Bill code from Shiprocket
  courierName   String?
  trackingUrl   String?
  status        String    @default("PENDING") // PENDING, READY_TO_SHIP, SHIPPED, DELIVERED, CANCELLED
  shiprocketOrderId String? // ID returned from Shiprocket API
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Message {
  id          String   @id @default(uuid())
  content     String   @db.Text
  read        Boolean  @default(false)
  
  // Relations
  senderId    String
  sender      User     @relation("SenderToMessage", fields: [senderId], references: [id])
  
  receiverId  String
  receiver    User     @relation("ReceiverToMessage", fields: [receiverId], references: [id])
  
  requestId   String?
  request     BookRequest? @relation(fields: [requestId], references: [id])
  
  orderId     String?
  order       Order?   @relation(fields: [orderId], references: [id])

  // Conversation-based messaging (v2)
  conversationId String?
  conversation   Conversation?       @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  type           String              @default("TEXT") // TEXT, OFFER, SYSTEM
  clientId       String?             // client-generated id for idempotent optimistic sends
  replyToId      String?
  replyTo        Message?            @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies        Message[]           @relation("MessageReplies")
  offerId        String?             @unique
  offer          BookOffer?          @relation(fields: [offerId], references: [id], onDelete: SetNull)
  meta           Json?               // structured payload for SYSTEM events
  editedAt       DateTime?
  deletedAt      DateTime?
  attachments    MessageAttachment[]
  reactions      MessageReaction[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([senderId, clientId])
  @@index([conversationId, createdAt])
  @@index([senderId, createdAt])
}

model Conversation {
  id                  String    @id @default(uuid())
  key                 String    @unique // "direct:<a>:<b>" or "listing:<bookId>:<buyerId>"
  type                String    @default("DIRECT") // DIRECT, LISTING
  createdById         String?

  bookId              String?
  book                Book?     @relation(fields: [bookId], references: [id], onDelete: SetNull)
  buyerId             String?
  sellerId            String?

  // Denormalised inbox preview (avoids N+1 last-message lookups)
  lastMessageId       String?
  lastMessageAt       DateTime?
  lastMessagePreview  String?
  lastMessageSenderId String?

  participants        ConversationParticipant[]
  messages            Message[]
  offers              BookOffer[]
  attachments         MessageAttachment[]

  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([bookId])
  @@index([lastMessageAt])
  @@index([createdById, createdAt])
}

model ConversationParticipant {
  id              String       @id @default(uuid())
  conversationId  String
  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId          String
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role            String       @default("MEMBER") // BUYER, SELLER, MEMBER
  lastReadAt      DateTime?
  lastDeliveredAt DateTime?
  isMuted         Boolean      @default(false)
  isArchived      Boolean      @default(false)
  isPinned        Boolean      @default(false)
  pinnedAt        DateTime?
  joinedAt        DateTime     @default(now())

  @@unique([conversationId, userId])
  @@index([userId, isArchived])
}

model MessageAttachment {
  id             String       @id @default(uuid())
  messageId      String?
  message        Message?     @relation(fields: [messageId], references: [id], onDelete: Cascade)
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  uploaderId     String
  kind           String       // IMAGE, FILE
  mimeType       String
  fileName       String
  size           Int
  width          Int?
  height         Int?
  data           Bytes        // private blob, only served through membership-checked route
  createdAt      DateTime     @default(now())

  @@index([messageId])
  @@index([conversationId, createdAt])
  @@index([uploaderId, createdAt])
}

model MessageReaction {
  id        String   @id @default(uuid())
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  emoji     String
  createdAt DateTime @default(now())

  @@unique([messageId, userId, emoji])
  @@index([messageId])
}

model BookOffer {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  bookId         String
  book           Book         @relation(fields: [bookId], references: [id], onDelete: Cascade)
  buyerId        String
  buyer          User         @relation("OfferBuyer", fields: [buyerId], references: [id], onDelete: Cascade)
  sellerId       String
  seller         User         @relation("OfferSeller", fields: [sellerId], references: [id], onDelete: Cascade)
  amount         Float
  listPrice      Float        // listing price snapshot at offer time
  status         String       @default("PENDING") // PENDING, ACCEPTED, REJECTED, WITHDRAWN, EXPIRED
  note           String?
  expiresAt      DateTime
  respondedAt    DateTime?
  message        Message?

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([conversationId])
  @@index([bookId, status])
  @@index([buyerId, status])
}

model UserBlock {
  id        String   @id @default(uuid())
  blockerId String
  blocker   User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

model UserReport {
  id             String   @id @default(uuid())
  reporterId     String
  reporter       User     @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedId     String
  reported       User     @relation("Reported", fields: [reportedId], references: [id], onDelete: Cascade)
  conversationId String?
  messageId      String?
  reason         String   // SPAM, SCAM, HARASSMENT, INAPPROPRIATE, OTHER
  details        String?  @db.Text
  status         String   @default("OPEN") // OPEN, REVIEWED, ACTIONED, DISMISSED
  createdAt      DateTime @default(now())

  @@index([reportedId])
  @@index([status, createdAt])
  @@index([reporterId, createdAt])
}

model BookClub {
  id           String           @id @default(uuid())
  name         String
  description  String           @db.Text
  bookTitle    String
  bookAuthor   String
  ebookKey     String?
  coverImage   String?
  scheduleText String?

  creatorId    String
  creator      User             @relation("ClubCreator", fields: [creatorId], references: [id], onDelete: Cascade)

  members      BookClubMember[]
  posts        BookClubPost[]

  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
}

model BookClubMember {
  id       String   @id @default(uuid())
  clubId   String
  club     BookClub @relation(fields: [clubId], references: [id], onDelete: Cascade)
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt DateTime @default(now())

  @@unique([clubId, userId])
}

model BookClubPost {
  id           String   @id @default(uuid())
  clubId       String
  club         BookClub @relation(fields: [clubId], references: [id], onDelete: Cascade)
  authorId     String
  author       User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  chapterLabel String?
  content      String   @db.Text
  createdAt    DateTime @default(now())
}

model Badge {
  id                    String      @id @default(uuid())
  code                  String?     @unique
  name                  String
  description           String
  category              String      // READING, REVIEW, MARKETPLACE, DONATION, COMMUNITY, PROGRESSION, SEASONAL, TRUST
  rarity                String      @default("COMMON") // COMMON, UNCOMMON, RARE, EPIC, LEGENDARY, MYTHIC
  iconUrl               String
  requirementThreshold  Int
  metricKey             String      @default("MANUAL")
  xpReward              Int         @default(50)
  pointsReward          Int         @default(25)
  isActive              Boolean     @default(true)
  startsAt              DateTime?
  endsAt                DateTime?

  users                 UserBadge[]

  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  @@index([category, isActive])
}

model XpTransaction {
  id             String    @id @default(uuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventType      String    // BOOK_COMPLETED, READING_SESSION, REVIEW_PUBLISHED, BOOK_LISTED, BOOK_SOLD, BOOK_PURCHASED, BOOK_DONATED, DAILY_CHECKIN, QUEST_CLAIMED, BADGE_UNLOCKED, CLUB_CONTRIBUTION, ADMIN_ADJUSTMENT, COSMETIC_UNLOCK
  idempotencyKey String    @unique
  sourceId       String?
  xpAmount       Int
  pointsAmount   Int       @default(0)
  description    String
  metadata       Json?
  reversedAt     DateTime?
  createdAt      DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([eventType, createdAt])
}

model UserActivity {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activityType String   // READING_SESSION, BOOK_COMPLETED, REVIEW_PUBLISHED, BOOK_LISTED, BOOK_SOLD, BOOK_DONATED, BADGE_UNLOCKED, LEVEL_UP, QUEST_COMPLETED, CLUB_POST
  title        String
  subtitle     String?
  sourceId     String?
  xpEarned     Int      @default(0)
  visibility   String   @default("PUBLIC") // PUBLIC, PRIVATE
  dayKey       String   // YYYY-MM-DD
  occurredAt   DateTime @default(now())

  @@index([userId, dayKey])
  @@index([userId, occurredAt])
}

model Quest {
  id             String           @id @default(uuid())
  code           String           @unique
  name           String
  description    String
  category       String           // DAILY, WEEKLY, EVENT
  metricKey      String           // READING_MINUTES_TODAY, LIBRARY_COUNT, REVIEWS_COUNT, CLUB_POSTS_COUNT, BOOKS_COMPLETED_WEEK, READING_SESSIONS_WEEK, DONATIONS_COUNT
  targetCount    Int
  rewardXp       Int
  rewardPoints   Int              @default(25)
  cosmeticReward String?
  startsAt       DateTime?
  endsAt         DateTime?
  isActive       Boolean          @default(true)
  claims         UserQuestClaim[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
}

model UserQuestClaim {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  questId   String
  quest     Quest    @relation(fields: [questId], references: [id], onDelete: Cascade)
  periodKey String   // YYYY-MM-DD for DAILY, YYYY-Www for WEEKLY, "EVENT" for EVENT
  xpAwarded Int
  claimedAt DateTime @default(now())

  @@unique([userId, questId, periodKey])
  @@index([userId, claimedAt])
}

model UserFollow {
  id          String   @id @default(uuid())
  followerId  String
  follower    User     @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  followingId String
  following   User     @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
  @@index([followingId])
  @@index([followerId])
}

model SupportTicket {
  id           String   @id @default(uuid())
  ticketCode   String   @unique
  userId       String?
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  name         String
  email        String
  category     String   // GENERAL, BUG_REPORT, USER_REPORT, SUSPICIOUS_LISTING, PAYMENT_ISSUE, COPYRIGHT_DMCA, ACCOUNT_ACCESS
  subject      String
  description  String   @db.Text
  referenceUrl String?
  status       String   @default("OPEN") // OPEN, IN_PROGRESS, WAITING_FOR_USER, RESOLVED, CLOSED
  responses    Json?    // Array of { senderName, role, message, createdAt }
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model HelpArticleFeedback {
  id        String   @id @default(uuid())
  slug      String
  userId    String?
  helpful   Boolean
  createdAt DateTime @default(now())

  @@index([slug])
}

model HelpCustomArticle {
  id        String   @id @default(uuid())
  slug      String   @unique
  title     String
  category  String
  summary   String
  body      String   @db.Text
  version   String   @default("1.0")
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserBadge {
  id          String   @id @default(uuid())
  earnedAt    DateTime @default(now())
  isPinned    Boolean  @default(false)
  
  // Relations
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  
  badgeId     String
  badge       Badge    @relation(fields: [badgeId], references: [id])

  @@unique([userId, badgeId])
}

model LibraryBook {
  id             String   @id @default(uuid())
  title          String
  author         String
  coverImage     String?
  platformBookId String?  // If linked to an existing book or external e-book ID
  gutenbergId    Int?     // If readable in the e-library (Project Gutenberg ID)
  status         String   @default("WANT_TO_READ") // WANT_TO_READ, READING, READ
  currentPage    Int      @default(1)
  totalPages     Int      @default(250)

  // Relations
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions       ReadingSession[]

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model ReadingSession {
  id              String   @id @default(uuid())
  durationMinutes Int
  
  // Relations
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  libraryBookId   String
  libraryBook     LibraryBook @relation(fields: [libraryBookId], references: [id], onDelete: Cascade)

  createdAt       DateTime @default(now())
}

model BookNote {
  id         String   @id @default(uuid())
  bookKey    String
  bookTitle  String
  bookAuthor String
  quoteText  String   @db.Text
  noteText   String?  @db.Text
  color      String   @default("amber") // amber, blue, emerald, rose
  pageNumber Int      @default(1)

  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model SellerReview {
  id                String       @id @default(uuid())
  rating            Int
  conditionAccurate Boolean      @default(true)
  meetupReliable    Boolean      @default(true)
  comment           String?      @db.Text

  orderId           String?      @unique
  order             Order?       @relation(fields: [orderId], references: [id], onDelete: Cascade)

  requestId         String?      @unique
  request           BookRequest? @relation(fields: [requestId], references: [id], onDelete: Cascade)

  reviewerId        String
  reviewer          User         @relation("ReviewerToReview", fields: [reviewerId], references: [id], onDelete: Cascade)

  sellerId          String
  seller            User         @relation("SellerToReview", fields: [sellerId], references: [id], onDelete: Cascade)

  createdAt         DateTime     @default(now())
}

model Wishlist {
  id        String   @id @default(uuid())
  title     String?  
  isbn      String?  
  
  // Relations
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt DateTime @default(now())
}

model Notification {
  id        String   @id @default(uuid())
  type      String   // e.g., "WISHLIST_ALERT", "NEW_MESSAGE", "BOOK_REQUEST", "BADGE_EARNED", "ORDER_UPDATE"
  message   String
  read      Boolean  @default(false)
  link      String?  
  
  // Relations
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt DateTime @default(now())
}

model Campaign {
  id            String     @id @default(uuid())
  title         String
  description   String     @db.Text
  ngoName       String
  targetBooks   Int
  currentBooks  Int        @default(0)
  startDate     DateTime   @default(now())
  endDate       DateTime?
  status        String     @default("ACTIVE") // ACTIVE, COMPLETED, CANCELLED
  imageUrl      String?

  donations     Donation[]

  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

model Donation {
  id            String    @id @default(uuid())
  trackingId    String    @unique @default(cuid()) // For public tracking
  status        String    @default("DONATED") // DONATED, COLLECTED, VERIFIED, SENT_TO_NGO, RECEIVED, DISTRIBUTED
  
  // Relations
  donorId       String
  donor         User      @relation("DonorToDonation", fields: [donorId], references: [id])
  
  bookId        String?   @unique
  book          Book?     @relation(fields: [bookId], references: [id])
  
  campaignId    String?
  campaign      Campaign? @relation(fields: [campaignId], references: [id])

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model CommunityRequest {
  id          String   @id @default(uuid())
  title       String
  author      String?
  description String?  @db.Text
  status      String   @default("OPEN") // OPEN, FULFILLED

  requesterId String
  requester   User     @relation("CommunityRequestToUser", fields: [requesterId], references: [id])

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
